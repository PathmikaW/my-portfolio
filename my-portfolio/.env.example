# Gmail SMTP for the /contact form  ->  src/app/api/contact/route.ts
# Create a Google App Password (needs 2-Step Verification on the account):
#   https://myaccount.google.com/apppasswords
# Copy these three keys into Vercel: Project -> Settings -> Environment Variables,
# then redeploy. For local dev, put real values in .env.local (gitignored).

# Gmail account that sends the mail
GMAIL_USER=your-sender@gmail.com

# 16-character app password (spaces are stripped automatically)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Inbox that receives contact submissions (defaults to GMAIL_USER if unset)
CONTACT_TO=you@example.com
